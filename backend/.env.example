# ── Required ──────────────────────────────────────────────────────────────────

# Shared secret validated on every /webhook/ingest request.
WEBHOOK_SECRET=your-random-webhook-secret

# API key for the LLM provider (OpenAI-compatible: Groq, OpenAI, etc.)
LLM_API_KEY=your-llm-api-key

# JWT signing secret for auth session cookies (use a long random string).
SESSION_SECRET=your-random-session-secret

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Database ──────────────────────────────────────────────────────────────────
# On Render, use a persistent disk path like /data/cicd-doctor.db
DATABASE_PATH=./data/cicd-doctor.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Never use a wildcard.
CORS_ORIGIN=http://localhost:5173

# ── URLs ───────────────────────────────────────────────────────────────────────
# Backend base URL (used for OAuth callback + notification links)
APP_BASE_URL=http://localhost:3000
# Frontend base URL (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ── Token Encryption ───────────────────────────────────────────────────────────
# 64-char hex string for AES-256-GCM encryption of stored OAuth tokens.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# ── GitHub OAuth (optional) ────────────────────────────────────────────────────
# From your GitHub OAuth App settings. If unset, GitHub features are disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Email Notifications via Brevo SMTP (optional) ──────────────────────────────
# Free at brevo.com — 300 emails/day, works on Render, sends to any address.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=CI/CD Failure Doctor <your-brevo-login@smtp-brevo.com>

# Fallback recipient for anonymous/demo build records (optional)
NOTIFICATION_EMAIL=

# ── Slack Notifications (optional) ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
