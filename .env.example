# ── Required ──────────────────────────────────────────────────────────────────

# Shared secret validated on every /webhook/ingest request.
# Must match the X-Webhook-Secret header sent by your CI system.
# The server will refuse to start if this is not set.
WEBHOOK_SECRET=changeme

# API key for the configured LLM provider (OpenAI or OpenAI-compatible endpoint).
# The server will refuse to start if this is not set.
LLM_API_KEY=sk-...

# ── LLM Configuration ─────────────────────────────────────────────────────────

# Model name passed to the LLM API.
# Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file. The directory must be writable.
# Default: ./data/cicd-doctor.db
DATABASE_PATH=./data/cicd-doctor.db

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# Default: 3000
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Never use a wildcard (*) — always list specific origins.
# Example: https://your-app.vercel.app,http://localhost:5173
# Default (if not set): http://localhost:5173 only
CORS_ORIGIN=http://localhost:5173

# ── Stretch: Notifications (optional) ─────────────────────────────────────────

# Slack Incoming Webhook URL. If set and non-empty, a diagnosis summary is
# POSTed to this URL whenever a build record transitions to status=complete.
# Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=

# Email address to send diagnosis summaries to via SMTP/nodemailer.
# If set and non-empty, an email is sent on each completed diagnosis.
# Leave blank to disable email notifications.
NOTIFICATION_EMAIL=

# Base URL of this application, used to construct diagnosis detail links
# in Slack and email notifications.
# Example: https://your-app.onrender.com
APP_BASE_URL=http://localhost:3000

# SMTP configuration for email notifications (required if NOTIFICATION_EMAIL is set)
# Default: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# SMTP port (typically 587 for TLS, 465 for SSL)
# Default: 587
SMTP_PORT=587

# SMTP authentication username (defaults to NOTIFICATION_EMAIL if not set)
SMTP_USER=

# SMTP authentication password (required if NOTIFICATION_EMAIL is set)
SMTP_PASS=
